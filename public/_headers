  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-XeJY1W9Eo2H75rpuZrD/zcYdnNMb5R09viTEUgGIGXs='; style-src 'self'; img-src 'self' https: data:; font-src 'self' https:; connect-src 'self'; frame-ancestors 'none'

